{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "nabu:block/withered_vine" }
    },
    {
      "when": { "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" },
      "apply": { "model": "nabu:block/withered_vine" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 90 }
    },
    {
      "when": { "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 180 }
    },
    {
      "when": { "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 270 }
    },
    {
      "when": { "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "y": 270 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "x": 270 }
    },
    {
      "when": { "east": "false", "north": "false", "south": "false", "up": "false", "west": "false" },
      "apply": { "model": "nabu:block/withered_vine", "uvlock": true, "x": 270 }
    }
  ]
}
